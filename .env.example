# Copy this file to .env.local and add your own private keys.
OPENAQ_API_KEY=
WAQI_API_KEY=
# Legacy name is also accepted by the server if already present in .env.local.
# WAQI_API_TOKEN=

# Official Government of India Open Data Portal (CPCB Ambient Air Quality dataset)
DATA_GOV_IN_API_KEY=

# Server-side Groq key for Ask Vayu. Do not expose it with a NEXT_PUBLIC_ variable.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
